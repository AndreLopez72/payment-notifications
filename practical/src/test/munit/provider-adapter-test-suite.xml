    <munit:test name="quetzal-maps-succeeded-event" description="Maps the supplied successful charge to the canonical event.">
        <munit:execution>
            <set-payload value="#[readUrl('classpath://providers/quetzal/01-charge-succeeded.json', 'application/json')]" />
            <set-variable variableName="receivedAt" value="2026-11-20T12:00:00Z" />
            <set-variable variableName="correlationId" value="test-correlation-001" />
            <flow-ref name="map-quetzal-event" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('captured')]" />
            <munit-tools:assert-that expression="#[payload.amount]" is="#[MunitTools::equalTo('1250.00')]" />
            <munit-tools:assert-that expression="#[payload.refundedAmount]" is="#[MunitTools::equalTo(null)]" />
            <munit-tools:assert-that expression="#[payload.policyNumber]" is="#[MunitTools::equalTo('POL-MX-000412785')]" />
            <munit-tools:assert-that expression="#[payload.eventId]" is="#[MunitTools::equalTo('MX:Quetzal:evt_01JDQ3K8M2X7')]" />
            <munit-tools:assert-that expression="#[payload.paymentKey]" is="#[MunitTools::equalTo('MX:Quetzal:c881f3570d51e1ca598f01d2339adc595fd9aeec4ce5ad2cb812dd1e5b59983f')]" />
            <munit-tools:assert-that expression="#[payload.correlationId]" is="#[MunitTools::equalTo('test-correlation-001')]" />
            <munit-tools:assert-that expression="#[payload.customer == null and payload.payment_method == null]" is="#[MunitTools::equalTo(true)]" />
        </munit:validation>
    </munit:test>

