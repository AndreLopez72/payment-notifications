    <munit:test name="andina-maps-reversal-event" description="Maps the supplied reversal to the refunded canonical state.">
        <munit:execution>
            <set-payload value="#[readUrl('classpath://providers/andina/04-transaccion-reversada.json', 'application/json')]" />
            <set-variable variableName="receivedAt" value="2026-11-20T12:00:00Z" />
            <set-variable variableName="correlationId" value="test-correlation-andina-003" />
            <flow-ref name="map-andina-event" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('refunded')]" />
            <munit-tools:assert-that expression="#[payload.refundedAmount]" is="#[MunitTools::equalTo(null)]" />
        </munit:validation>
    </munit:test>
</mule>
