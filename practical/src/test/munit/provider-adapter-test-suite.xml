    <munit:test name="andina-retry-keeps-business-event-identity" description="A retry has a new notification ID but the same business-event identity.">
        <munit:execution>
            <set-payload value="#[readUrl('classpath://providers/andina/02-transaccion-aprobada.json', 'application/json')]" />
            <set-variable variableName="receivedAt" value="2026-11-20T12:00:00Z" />
            <set-variable variableName="correlationId" value="test-correlation-andina-002" />
            <flow-ref name="map-andina-event" />
            <set-variable variableName="firstEvent" value="#[payload]" />
            <set-payload value="#[readUrl('classpath://providers/andina/03-transaccion-aprobada-reintento.json', 'application/json')]" />
            <flow-ref name="map-andina-event" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.eventId == vars.firstEvent.eventId]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that expression="#[payload.providerEventId != vars.firstEvent.providerEventId]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('captured')]" />
        </munit:validation>
    </munit:test>

