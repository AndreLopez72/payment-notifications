                          value="#[readUrl('classpath://providers/quetzal/01-charge-succeeded.json', 'application/octet-stream') as Binary]" />
            <set-variable variableName="signatureHeader"
                          value="t=1795888803,v1=2d07770582c02f15235ac4e027b7732beef86be103c574a1c3b988a4275f5031" />
            <set-variable variableName="webhookSecret" value="qz_test_whsec_4f8a1c2e9b7d" />
            <set-variable variableName="nowEpochSeconds" value="1795888803" />
            <flow-ref name="verify-quetzal-signature" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(true)]" />
